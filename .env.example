# Resumind Configuration
# All env vars use RESUMIND_ prefix for settings resolution

# Core
RESUMIND_ENV=development
RESUMIND_SECRET_KEY=change-me-in-production
RESUMIND_DATABASE_URL=postgresql+asyncpg://resumind:resumind@localhost:5432/resumind
RESUMIND_REDIS_URL=redis://localhost:6379/0

# LLM Providers
RESUMIND_LLM_PROVIDER=ollama
RESUMIND_DEFAULT_MODEL=deepseek-v4-flash
RESUMIND_OLLAMA_HOST=https://ollama.com
RESUMIND_OLLAMA_API_KEY=
RESUMIND_GEMINI_API_KEY=

# Observability
RESUMIND_LANGFUSE_HOST=http://localhost:3000
RESUMIND_LANGFUSE_PUBLIC_KEY=
RESUMIND_LANGFUSE_SECRET_KEY=
RESUMIND_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Integrations
RESUMIND_NAUKRI_API_KEY=
RESUMIND_NAUKRI_API_SECRET=
RESUMIND_INDEED_PUBLISHER_ID=
RESUMIND_INDEED_API_KEY=
RESUMIND_GLASSDOOR_PARTNER_ID=
RESUMIND_GLASSDOOR_API_KEY=

# Celery
RESUMIND_CELERY_BROKER_URL=redis://localhost:6379/0
RESUMIND_CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Original env vars (kept for backward compat with prompt.py)
LLM_PROVIDER=ollama
DEFAULT_MODEL=deepseek-v4-flash
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
GEMINI_API_KEY=