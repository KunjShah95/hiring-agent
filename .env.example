# ---------------------------------------------------------------
# Resumind — Environment Configuration
# Copy this file to .env and fill in your values
#   $ cp .env.example .env
# ---------------------------------------------------------------

# --- Core ------------------------------------------------------
RESUMIND_ENV=development                    # development | staging | production
RESUMIND_SECRET_KEY=change-me-to-random-key
RESUMIND_DATABASE_URL=                      # postgresql://user:pass@host:5432/dbname
RESUMIND_REDIS_URL=                         # redis://host:6379/0

# --- LLM Providers ---------------------------------------------
RESUMIND_LLM_PROVIDER=ollama                # ollama | gemini
RESUMIND_DEFAULT_MODEL=deepseek-v4-flash    # Model name to use

# Ollama (local or cloud)
RESUMIND_OLLAMA_HOST=                       # http://localhost:11434 or https://ollama.com
RESUMIND_OLLAMA_API_KEY=                    # Required for Ollama Cloud

# Google Gemini
RESUMIND_GEMINI_API_KEY=                    # https://aistudio.google.com/apikey

# --- Observability ---------------------------------------------

# LangFuse (LLM trace observability)
RESUMIND_LANGFUSE_HOST=                     # http://localhost:3000
RESUMIND_LANGFUSE_PUBLIC_KEY=
RESUMIND_LANGFUSE_SECRET_KEY=

# OpenTelemetry (traces)
RESUMIND_OTEL_EXPORTER_OTLP_ENDPOINT=      # http://localhost:4317

# --- Celery (Async Queue) --------------------------------------
RESUMIND_CELERY_BROKER_URL=redis://localhost:6379/0
RESUMIND_CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Job Board Integrations ------------------------------------
RESUMIND_NAUKRI_API_KEY=
RESUMIND_NAUKRI_API_SECRET=
RESUMIND_INDEED_PUBLISHER_ID=
RESUMIND_INDEED_API_KEY=
RESUMIND_GLASSDOOR_PARTNER_ID=
RESUMIND_GLASSDOOR_API_KEY=

# --- GitHub ----------------------------------------------------
GITHUB_TOKEN=                           # Personal access token for higher API rate limits

# --- Legacy env vars (read directly by prompt.py) --------------
LLM_PROVIDER=ollama
DEFAULT_MODEL=deepseek-v4-flash
OLLAMA_HOST=
OLLAMA_API_KEY=
GEMINI_API_KEY=
