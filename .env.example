# ---------------------------------------------------------------
# Kunj — Environment Configuration
# Copy this file to .env and fill in your values
#   $ cp .env.example .env
# ---------------------------------------------------------------

# --- Core ------------------------------------------------------
KUNJ_ENV=development                    # development | staging | production
KUNJ_SECRET_KEY=change-me-to-random-key
KUNJ_DATABASE_URL=                      # postgresql://user:pass@host:5432/dbname
KUNJ_REDIS_URL=                         # redis://host:6379/0

# --- LLM Providers ---------------------------------------------
KUNJ_LLM_PROVIDER=ollama                # ollama | gemini
KUNJ_DEFAULT_MODEL=deepseek-v4-flash    # Model name to use

# Ollama (local or cloud)
KUNJ_OLLAMA_HOST=                       # http://localhost:11434 or https://ollama.com
KUNJ_OLLAMA_API_KEY=                    # Required for Ollama Cloud

# Google Gemini
KUNJ_GEMINI_API_KEY=                    # https://aistudio.google.com/apikey

# --- Observability ---------------------------------------------

# LangFuse (LLM trace observability)
KUNJ_LANGFUSE_HOST=                     # http://localhost:3000
KUNJ_LANGFUSE_PUBLIC_KEY=
KUNJ_LANGFUSE_SECRET_KEY=

# OpenTelemetry (traces)
KUNJ_OTEL_EXPORTER_OTLP_ENDPOINT=      # http://localhost:4317

# --- Celery (Async Queue) --------------------------------------
KUNJ_CELERY_BROKER_URL=redis://localhost:6379/0
KUNJ_CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Job Board Integrations ------------------------------------
KUNJ_NAUKRI_API_KEY=
KUNJ_NAUKRI_API_SECRET=
KUNJ_INDEED_PUBLISHER_ID=
KUNJ_INDEED_API_KEY=
KUNJ_GLASSDOOR_PARTNER_ID=
KUNJ_GLASSDOOR_API_KEY=

# --- GitHub ----------------------------------------------------
GITHUB_TOKEN=                           # Personal access token for higher API rate limits

# --- Legacy env vars (read directly by prompt.py) --------------
LLM_PROVIDER=ollama
DEFAULT_MODEL=deepseek-v4-flash
OLLAMA_HOST=
OLLAMA_API_KEY=
GEMINI_API_KEY=
